            </Style>
            <Format>image/png</Format>
            <ResourceURL format="image/png" resourceType="tile"
                template="https://example.com/wmts/wide_at_low_zoom/{TileMatrixSet}/{TileMatrix}/{TileCol}/{TileRow}.png"/>
