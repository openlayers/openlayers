    <Contents>
        <!-- A layer available over a wider area at low zoom levels than at high ones, without a BoundingBox -->
        <Layer>
            <ows:Title>Wide at low zoom</ows:Title>
            <ows:Identifier>wide_at_low_zoom</ows:Identifier>
            <Style isDefault="true">
